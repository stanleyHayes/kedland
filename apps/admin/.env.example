# Dashboard (apps/admin) — environment contract.
#
# Next reads `.env` from THIS directory, not the repository root. Copy to `.env`
# and fill in; `./dev.sh` regenerates `.env` here on every run with the ports it
# actually chose.
#
# Files in this directory, and who wins:
#   .env.example      committed. Names only, never values. This file.
#   .env              gitignored. Local development. Written by ./dev.sh.
#   .env.production   gitignored. Local *production* builds only.
#
# In deployment nothing here is read: Vercel's project settings are the source
# of truth, and these files are not uploaded.

# ─────────────────────────────────────────────────────────────────────────────
# Anything prefixed NEXT_PUBLIC_ is INLINED INTO THE BROWSER BUNDLE at build
# time. Never put a secret behind that prefix — and note that a dashboard being
# staff-only is no protection at all: the bundle is served to the browser
# before anyone signs in.
# ─────────────────────────────────────────────────────────────────────────────

# The API, as the browser calls it. The dashboard is a client of the same API
# the public site uses; it just holds an access token.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# The API, as the server calls it during rendering.
API_INTERNAL_URL=http://localhost:8080/api/v1

# The public site, so the dashboard can link an editor to the page they just
# changed ("view on site").
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Server-only.
# ─────────────────────────────────────────────────────────────────────────────

# Signs the cookie that holds the staff session. Minimum 32 characters.
# Generate with: openssl rand -base64 48
# Rotating it signs everyone out, which is the intended emergency behaviour.
SESSION_SECRET=
