# Public site (apps/web) — environment contract.
#
# Next reads `.env` from THIS directory, not the repository root. The root
# `.env` is the API's; these are the site's.
#
# Copy to `.env` and fill in. `./dev.sh` regenerates `.env` here on every run
# with the ports it actually chose, so for local development you do not need to
# touch it — edit `.env.secrets` at the repository root instead, which dev.sh
# never overwrites.
#
# Files in this directory, and who wins:
#   .env.example      committed. Names only, never values. This file.
#   .env              gitignored. Local development. Written by ./dev.sh.
#   .env.production   gitignored. Local *production* builds only.
#
# In deployment nothing here is read: Vercel's project settings are the source
# of truth, and these files are not uploaded.

# ─────────────────────────────────────────────────────────────────────────────
# Anything prefixed NEXT_PUBLIC_ is INLINED INTO THE BROWSER BUNDLE at build
# time. It is public, permanently, to everyone who loads the site. Never put a
# secret behind that prefix.
# ─────────────────────────────────────────────────────────────────────────────

# The site's own canonical origin. Used for metadata, sitemap and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The API, as the *browser* calls it. Used by the enquiry form.
# Must be reachable from a visitor's machine, and must appear in the CSP's
# connect-src — `src/lib/csp.ts` derives that from this value.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# The API, as the *server* calls it during rendering and static generation.
# Usually the same host; in Docker it is the service name, and on Vercel it can
# be the API's internal URL to skip a public round trip.
API_INTERNAL_URL=http://localhost:8080/api/v1

# Cloudflare Turnstile's site key. Public by design — the secret half lives in
# the API. Blank means the widget is not rendered and the form still submits;
# the API only demands a token when it has a secret of its own.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Analytics measurement id. Blank means no analytics script is loaded at all.
NEXT_PUBLIC_ANALYTICS_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Server-only. No NEXT_PUBLIC_ prefix, so these never reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Shared with the API. The API calls POST /api/revalidate here when an editor
# publishes, so the statically rendered pages refresh immediately instead of
# waiting out the one-hour window. Must match REVALIDATE_SECRET in the API's
# environment exactly — rotating it is a two-sided deploy.
REVALIDATE_SECRET=
