{
  "name": "@kedland/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared ESLint, TypeScript, Prettier and Tailwind presets",
  "type": "module",
  "exports": {
    "./eslint/base": "./eslint/base.mjs",
    "./eslint/react": "./eslint/react.mjs",
    "./eslint/next": "./eslint/next.mjs",
    "./eslint/nest": "./eslint/nest.mjs",
    "./eslint/library": "./eslint/library.mjs",
    "./eslint/vitest": "./eslint/vitest.mjs",
    "./prettier": "./prettier/index.mjs",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./tsconfig/next.json": "./tsconfig/next.json",
    "./tsconfig/nest.json": "./tsconfig/nest.json"
  },
  "files": [
    "eslint",
    "prettier",
    "rules",
    "tsconfig"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "echo \"@kedland/config is plain JS + JSON — nothing to typecheck\""
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-jest": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
