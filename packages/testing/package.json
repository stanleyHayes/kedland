{
  "name": "@kedland/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Shared test harness — factories, fixtures and custom matchers",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./factories": "./src/factories/index.ts",
    "./matchers": "./src/matchers/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@kedland/types": "workspace:*",
    "@kedland/ui": "workspace:*"
  },
  "devDependencies": {
    "@kedland/config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
