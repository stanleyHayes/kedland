# Kedland International School — environment contract.
#
# Copy to `.env` and fill in. Values NEVER get committed; this file documents
# names only. Production values live in Render (API, see render.yaml) and in the
# Vercel project settings (web, admin).
#
# `apps/api/src/config/env.validation.ts` validates all of this at boot and the
# process refuses to start if something required is missing or malformed. A test
# asserts that every key in that schema appears here, so the two cannot drift.

# ─────────────────────────────────────────────────────────────────────────────
# API  (apps/api)
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# Local Mongo comes from docker-compose.yml, which binds 27018 on the host so
# it cannot collide with a system-wide Mongo. Production is an Atlas
# mongodb+srv:// URI.
MONGODB_URI=mongodb://localhost:27018
MONGODB_DB=kedland

# Comma-separated allowlist. Never `*` — the API answers to our two Next apps
# and nothing else. Keep in step with render.yaml's CORS_ORIGINS.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Minimum 32 characters each, and they must differ from one another: sharing a
# key means a leaked access token can mint refresh tokens.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-str
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Media (Cloudinary) ───────────────────────────────────────────────────────
# Optional in development; blob storage for post covers and page imagery.
# Render's disk is ephemeral, so nothing durable is ever written locally.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Mail (Resend) ────────────────────────────────────────────────────────────
# Required in production: without these the contact form has nowhere to send a
# parent's enquiry. Enquiries are persisted before delivery is attempted, so a
# Resend outage loses nothing — but nobody gets told.
# MAIL_TO_SCHOOL is PENDING from the client (their Google Workspace address).
RESEND_API_KEY=
MAIL_FROM=Kedland International School <noreply@kedland.edu.gh>
MAIL_TO_SCHOOL=

# ── Rate limits ──────────────────────────────────────────────────────────────
# Requests per minute per IP. The login route has its own, much tighter, ceiling
# because it is the one endpoint worth brute-forcing. The integration suite
# raises both, since every test request shares one IP.
THROTTLE_LIMIT=120
THROTTLE_LOGIN_LIMIT=8

# ── Spam protection (Cloudflare Turnstile) ───────────────────────────────────
# Required in production. Verified server-side; the site key is public, this
# secret is not.
TURNSTILE_SECRET_KEY=

# ── Cache invalidation ───────────────────────────────────────────────────────
# Publishing a post or editing page copy calls this webhook so the statically
# rendered public site refreshes. The secret must match the web app's copy —
# rotating it is a two-sided deploy.
REVALIDATE_WEBHOOK_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-to-a-long-random-string-min-32

# ── Seed ─────────────────────────────────────────────────────────────────────
# Consumed once by `pnpm --filter @kedland/api seed` to create the first admin.
SEED_ADMIN_EMAIL=admin@kedland.edu.gh
SEED_ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Public site  (apps/web)  — :3000
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# Server-to-server calls from React Server Components. In Docker this is the
# service name; in production it is the public API host.
API_INTERNAL_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_ANALYTICS_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Dashboard  (apps/admin)  — :3001
# ─────────────────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string-min-32
